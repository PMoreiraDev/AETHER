<?xml version="1.0" encoding="UTF-8"?>

<!--
    profile_view.fxml
    ================
    Vista de perfil do utilizador, carregada no contentArea do shell.
    Apresenta o resumo do perfil, atividade recente, informações pessoais,
    conquistas e ações rápidas — alimentada por ProfileViewController.

    Layout:
      - HBox com duas colunas:
          esquerda  → Profile Summary + Recent Activity
          direita  → Personal Information + Achievements + Quick Actions
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.shape.Circle?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ProfileViewController"
      fitToWidth="true"
      hbarPolicy="NEVER"
      vbarPolicy="AS_NEEDED"
      styleClass="profile-view-scroll">
    <content>
        <VBox spacing="16" styleClass="profile-view-root">

    <HBox spacing="16" styleClass="profile-view-columns">

    <!-- ========================================================= -->
    <!-- COLUNA ESQUERDA: Profile Summary + Recent Activity          -->
    <!-- ========================================================= -->
    <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="profile-view-left">
        <padding>
            <Insets top="20" right="0" bottom="20" left="20"/>
        </padding>

        <!-- Profile Summary Card -->
        <VBox spacing="14" styleClass="dash-card, profile-summary-card">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <children>
                <!-- Header row: Avatar + Name/Roles + Edit button -->
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <!-- Avatar with glow ring -->
                        <StackPane alignment="CENTER" styleClass="profile-avatar-wrapper">
                            <children>
                                <Circle radius="44" styleClass="profile-avatar-glow"/>
                                <StackPane>
                                    <children>
                                        <Circle radius="38" styleClass="profile-avatar-circle"/>
                                        <ImageView fx:id="profileAvatarImageView" fitWidth="76" fitHeight="76" preserveRatio="false" visible="false" mouseTransparent="true"/>
                                        <Label fx:id="profileInitialsLabel" text="AU" styleClass="profile-avatar-initials"/>
                                        <Circle radius="6" styleClass="profile-avatar-status-dot"
                                                translateX="24" translateY="24"/>
                                    </children>
                                </StackPane>
                            </children>
                        </StackPane>

                        <!-- Name + Roles -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="profileNameLabel" text="AETHER User" styleClass="profile-name"/>
                                <Label fx:id="profileRolesLabel" text="" styleClass="profile-roles"/>
                                <Label fx:id="profileBioLabel" text="" styleClass="profile-bio" wrapText="true" maxWidth="400"/>
                            </children>
                        </VBox>

                        <!-- Edit Profile button -->
                        <Button text="Edit Profile" styleClass="profile-edit-btn" onAction="#handleEditProfile"/>
                    </children>
                </HBox>

                <!-- Skill Badges -->
                <HBox fx:id="profileSkillsBox" spacing="8" alignment="CENTER_LEFT" styleClass="profile-skills-row">
                    <children>
                        <Label text="No skills added yet." styleClass="profile-empty-hint"/>
                    </children>
                </HBox>

                <Separator styleClass="dash-separator"/>

                <!-- Stats counter bar -->
                <HBox spacing="0" alignment="CENTER" styleClass="profile-stats-bar">
                    <children>
                        <VBox spacing="2" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="profile-stat-item">
                            <Label fx:id="statProjectsLabel" text="0" styleClass="profile-stat-value"/>
                            <Label text="Projects" styleClass="profile-stat-label"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="profile-stat-item">
                            <Label fx:id="statTasksLabel" text="0" styleClass="profile-stat-value"/>
                            <Label text="Tasks Done" styleClass="profile-stat-label"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="profile-stat-item">
                            <Label fx:id="statEventsLabel" text="0" styleClass="profile-stat-value"/>
                            <Label text="Events" styleClass="profile-stat-label"/>
                        </VBox>
                        <VBox spacing="2" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="profile-stat-item">
                            <Label fx:id="statYearsLabel" text="0" styleClass="profile-stat-value"/>
                            <Label text="Years" styleClass="profile-stat-label"/>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Recent Activity Card -->
        <VBox spacing="10" styleClass="dash-card, profile-activity-card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="📡" styleClass="profile-section-icon"/>
                        <Label text="Recent Activity" styleClass="dash-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="View All →" styleClass="profile-view-all-link"/>
                    </children>
                </HBox>
                <Separator styleClass="dash-separator"/>
                <VBox fx:id="activityContainer" spacing="8" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="No activity yet." styleClass="profile-empty-hint"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </VBox>

    <!-- ========================================================= -->
    <!-- COLUNA DIREITA: Personal Info + Achievements + Quick Actions -->
    <!-- ========================================================= -->
    <VBox spacing="16" styleClass="profile-view-right" minWidth="230" maxWidth="260">
        <padding>
            <Insets top="20" right="20" bottom="20" left="0"/>
        </padding>

        <!-- Personal Information Card -->
        <VBox spacing="10" styleClass="dash-card, profile-info-card">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="👤" styleClass="profile-section-icon"/>
                        <Label text="Personal Information" styleClass="dash-card-title-sm"/>
                    </children>
                </HBox>
                <Separator styleClass="dash-separator"/>

                <!-- Full Name -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Full Name" styleClass="profile-info-label"/>
                        <Label fx:id="infoFullNameLabel" text="—" styleClass="profile-info-value"/>
                    </children>
                </VBox>

                <!-- Preferred Name -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Preferred Name" styleClass="profile-info-label"/>
                        <Label fx:id="infoPreferredNameLabel" text="—" styleClass="profile-info-value"/>
                    </children>
                </VBox>

                <!-- Birthday -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Birthday" styleClass="profile-info-label"/>
                        <Label fx:id="infoBirthdayLabel" text="—" styleClass="profile-info-value"/>
                    </children>
                </VBox>

                <!-- Occupations -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Occupations" styleClass="profile-info-label"/>
                        <Label fx:id="infoOccupationsLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- About -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="About" styleClass="profile-info-label"/>
                        <Label fx:id="infoAboutLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Location -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Location" styleClass="profile-info-label"/>
                        <Label fx:id="infoLocationLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Studies -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Studies" styleClass="profile-info-label"/>
                        <Label fx:id="infoStudiesLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Experience -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Experience" styleClass="profile-info-label"/>
                        <Label fx:id="infoExperienceLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Skills -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Skills" styleClass="profile-info-label"/>
                        <Label fx:id="infoSkillsLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Interests -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Interests" styleClass="profile-info-label"/>
                        <Label fx:id="infoInterestsLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Objectives -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Objectives" styleClass="profile-info-label"/>
                        <Label fx:id="infoObjectivesLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Preferences -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Preferences" styleClass="profile-info-label"/>
                        <Label fx:id="infoPreferencesLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Projects -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Projects" styleClass="profile-info-label"/>
                        <Label fx:id="infoProjectsLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Work Style -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Work Style" styleClass="profile-info-label"/>
                        <Label fx:id="infoWorkStyleLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>

                <!-- Summary -->
                <VBox spacing="2" styleClass="profile-info-row">
                    <children>
                        <Label text="Summary" styleClass="profile-info-label"/>
                        <Label fx:id="infoSummaryLabel" text="—" styleClass="profile-info-value" wrapText="true"/>
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Achievements Card -->
        <VBox spacing="10" styleClass="dash-card, profile-achievements-card">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="🏆" styleClass="profile-section-icon"/>
                        <Label text="Achievements" styleClass="dash-card-title-sm"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="View All →" styleClass="profile-view-all-link"/>
                    </children>
                </HBox>
                <Separator styleClass="dash-separator"/>
                <HBox fx:id="achievementsBox" spacing="12" alignment="CENTER" styleClass="profile-achievements-row">
                    <children>
                        <Label text="No achievements yet." styleClass="profile-empty-hint"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Quick Actions Card -->
        <VBox spacing="6" styleClass="dash-card, profile-actions-card">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
            <children>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Label text="⚡" styleClass="profile-section-icon"/>
                        <Label text="Quick Actions" styleClass="dash-card-title-sm"/>
                    </children>
                </HBox>
                <Separator styleClass="dash-separator"/>

                <Button text="🔒  Change Password" styleClass="profile-quick-action" onAction="#handleChangePassword" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="🔔  Manage Notifications" styleClass="profile-quick-action" onAction="#handleManageNotifications" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <Button text="🛡️  Privacy Settings" styleClass="profile-quick-action" onAction="#handlePrivacySettings" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            </children>
        </VBox>
    </VBox>
    </HBox>

    <!-- ========================================================= -->
    <!-- SUGGESTED UPDATES — AI-suggested, requires user confirmation -->
    <!-- ========================================================= -->
    <VBox spacing="10" styleClass="profile-suggested-card" alignment="TOP_LEFT">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <children>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <children>
                    <Label text="⚡" styleClass="profile-section-icon"/>
                    <Label text="Suggested Updates" styleClass="dash-card-title"/>
                    <Label fx:id="suggestedUpdatesLabel" text="No pending suggestions. AETHER will suggest updates here when it learns new things about you." styleClass="profile-suggested-hint" wrapText="true"/>
                </children>
            </HBox>
            <Label text="When AETHER detects new information about you during conversations, it will suggest profile updates here. You decide whether to apply them — AI never modifies your profile without your confirmation."
                   styleClass="profile-suggested-hint" wrapText="true"/>
            <VBox fx:id="suggestedUpdatesContainer" spacing="10"/>
        </children>
    </VBox>

    <!-- ========================================================= -->
    <!-- AI CONTEXT — Central context note (full width)              -->
    <!-- ========================================================= -->
    <VBox spacing="10" styleClass="dash-card, profile-ai-context-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>
        <children>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <children>
                    <Label text="🧠" styleClass="profile-section-icon"/>
                    <Label text="AI Context" styleClass="dash-card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="contextStatusLabel" text="" styleClass="profile-context-status"/>
                </children>
            </HBox>
            <Label text="Your AI Context" styleClass="profile-ai-context-subtitle"/>
            <Label text="Your name, preferred name, birthday, occupation/roles and About information are included automatically in AETHER's context. Use the box below for additional details, goals, preferences, routines, projects or anything else you want AETHER to remember."
                   styleClass="profile-ai-context-hint" wrapText="true"/>
            <Label text="Automatic profile context ✓" styleClass="profile-context-auto-label"/>
            <!-- Toolbar de markdown — reutiliza as mesmas classes CSS das Notes
                 (note-toolbar / note-toolbar-btn) para uma experiência de
                 edição idêntica à das Notes (spec #12, #13). -->
            <HBox fx:id="aiContextToolbar" styleClass="note-toolbar" spacing="4" alignment="CENTER_LEFT">
                <Button text="B" styleClass="note-toolbar-btn" onAction="#ctxInsertBold"/>
                <Button text="I" styleClass="note-toolbar-btn" onAction="#ctxInsertItalic"/>
                <Button text="H1" styleClass="note-toolbar-btn" onAction="#ctxInsertH1"/>
                <Button text="H2" styleClass="note-toolbar-btn" onAction="#ctxInsertH2"/>
                <Button text="• List" styleClass="note-toolbar-btn" onAction="#ctxInsertBullet"/>
                <Button text="1. List" styleClass="note-toolbar-btn" onAction="#ctxInsertNumbered"/>
                <Button text="❝ Quote" styleClass="note-toolbar-btn" onAction="#ctxInsertQuote"/>
                <Button text="&lt;/&gt;" styleClass="note-toolbar-btn" onAction="#ctxInsertCode"/>
                <Button text="Link" styleClass="note-toolbar-btn" onAction="#ctxInsertLink"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ToggleButton fx:id="aiContextPreviewBtn" text="%notes.editor.preview" styleClass="note-mode-btn" onAction="#ctxTogglePreview"/>
            </HBox>
            <TextArea fx:id="aiContextInput" promptText="Add anything else AETHER should know about you..."
                      styleClass="area-texto, profile-ai-context-input" wrapText="true" prefRowCount="8" VBox.vgrow="ALWAYS"/>
            <!-- Painel de preview — reutiliza NoteMarkdownRenderer, igual às Notes. -->
            <VBox fx:id="aiContextPreview" styleClass="ai-context-preview" managed="false" visible="false" VBox.vgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <children>
                    <Button text="Save Context" styleClass="profile-save-context-btn" onAction="#handleSaveContext"/>
                </children>
            </HBox>
        </children>
    </VBox>

        </VBox>
    </content>
</ScrollPane>
