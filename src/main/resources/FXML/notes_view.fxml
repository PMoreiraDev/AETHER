<?xml version="1.0" encoding="UTF-8"?>

<!--
    notes_view.fxml
    ===============
    Vista de notas, carregada no contentArea do shell do dashboard.
    Apresenta a lista de notas com título, data, pré-visualização do texto
    e badge de resumo de extração — alimentada por NotesViewController.

    Layout:
      - VBox root (.dash-view-root)
          - Header: HBox com título "Notes" + botão "Add Note"
          - ScrollPane com contentor de cartões de nota
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.NotesViewController"
      spacing="0"
      styleClass="dash-view-root">

    <!-- ========================================================= -->
    <!-- HEADER                                                     -->
    <!-- ========================================================= -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="settings-header">
        <padding>
            <Insets top="28" right="34" bottom="20" left="34"/>
        </padding>
        <children>
            <Label text="Notes" styleClass="settings-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Add Note" onAction="#handleAddNote" styleClass="dash-add-note-btn"/>
        </children>
    </HBox>

    <!-- ========================================================= -->
    <!-- CONTENT                                                    -->
    <!-- ========================================================= -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="settings-scroll">
        <content>
            <VBox fx:id="notesContainer" spacing="10" styleClass="settings-content">
                <children>
                    <Label text="No notes added yet." styleClass="dash-empty-state"/>
                </children>
            </VBox>
        </content>
    </ScrollPane>

</VBox>
