<?xml version="1.0" encoding="UTF-8"?>

<!--
    LauncherApp.fxml
    ================
    Vista do ecrã de arranque do AETHER (padrão MVC).
    Controlador: controller.LauncherController
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.LauncherController"
           styleClass="root-pane">

    <children>

        <!-- Fundo: dimensionado pelo controlador para cobrir toda a janela. -->
        <ImageView fx:id="backgroundImageView" preserveRatio="false" smooth="true">
            <image>
                <Image url="@../images/background.jpg"/>
            </image>
        </ImageView>

        <!-- Conteúdo principal: logótipo, botão de arranque e rodapé. -->
        <VBox alignment="CENTER" spacing="40" styleClass="conteudo-central">
            <padding>
                <Insets bottom="70"/>
            </padding>
            <children>

                <!-- Logótipo AETHER -->
                <ImageView fitWidth="360" preserveRatio="true" smooth="true" styleClass="logo-imagem">
                    <image>
                        <Image url="@../images/aether_logo_mark.png"/>
                    </image>
                </ImageView>

                <!-- Botão principal: indicador + texto + seta -->
                <Button fx:id="startButton" onAction="#handleStartAether" styleClass="botao-start">
                    <graphic>
                        <HBox alignment="CENTER" spacing="16">
                            <children>
                                <Circle radius="4" styleClass="indicador-start"/>
                                <Label text="S T A R T   A E T H E R" styleClass="texto-start"/>
                                <Label text="→" styleClass="seta-start"/>
                            </children>
                        </HBox>
                    </graphic>
                </Button>

                <!-- Rodapé informativo de privacidade -->
                <HBox alignment="CENTER" spacing="8" styleClass="rodape">
                    <children>
                        <Label text="🔒" styleClass="icone-cadeado"/>
                        <Label text="Everything stays on your device." styleClass="rodape-texto"/>
                    </children>
                </HBox>

            </children>
        </VBox>

    </children>
</StackPane>
