<?xml version="1.0" encoding="UTF-8"?>

<!--
    projects_view.fxml
    ===================
    Vista de projetos, carregada no contentArea do shell do dashboard.
    Apresenta a lista de projetos com nome, estado, deadline e relações —
    alimentada por ProjectsViewController. Estrutura idêntica a
    tasks_view.fxml, para se manter coerente com o resto do dashboard.

    Layout:
      - VBox root (.dash-view-root)
          - Header: HBox com título "Projects" + botão "Add Project"
          - ScrollPane com contentor de cartões de projeto
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ProjectsViewController"
      spacing="0"
      styleClass="dash-view-root">

    <!-- ========================================================= -->
    <!-- HEADER                                                     -->
    <!-- ========================================================= -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="settings-header">
        <padding>
            <Insets top="28" right="34" bottom="20" left="34"/>
        </padding>
        <children>
            <Label text="%entity.projects.title" styleClass="settings-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%entity.projects.add" onAction="#handleAddProject" styleClass="dash-add-note-btn"/>
        </children>
    </HBox>

    <!-- ========================================================= -->
    <!-- CONTENT                                                    -->
    <!-- ========================================================= -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="settings-scroll">
        <content>
            <VBox fx:id="projectsContainer" spacing="10" styleClass="settings-content">
                <children>
                    <Label text="No projects added yet." styleClass="dash-empty-state"/>
                </children>
            </VBox>
        </content>
    </ScrollPane>

</VBox>
