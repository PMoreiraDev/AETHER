<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SettingsController" styleClass="dash-view-root">
    <top>
        <VBox spacing="5" styleClass="settings-header">
            <padding><Insets top="28" right="34" bottom="20" left="34"/></padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="Settings" styleClass="settings-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh" onAction="#handleRefresh" styleClass="settings-secondary-btn"/>
                </HBox>
                <Label text="Manage your local AETHER AI model and folders" styleClass="settings-subtitle"/>
            </children>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="settings-scroll">
            <content>
                <VBox spacing="18" styleClass="settings-content">
                    <VBox spacing="6" styleClass="settings-active-card">
                        <Label text="ACTIVE MODEL" styleClass="settings-section-label"/>
                        <Label fx:id="activeModelLabel" text="No model selected" styleClass="settings-active-model"/>
                        <Label text="AETHER AI uses this model for every chat. Changing it is saved locally." styleClass="settings-help" wrapText="true"/>
                    </VBox>

                    <Label text="FOLDERS" styleClass="settings-section-title"/>
                    <VBox spacing="6" styleClass="settings-active-card">
                        <Label text="AETHER VAULT FOLDER" styleClass="settings-section-label"/>
                        <Label text="Where your people, events, tasks and notes are stored as Markdown files. Changing this folder switches the active vault — existing files are not moved automatically." styleClass="settings-help" wrapText="true"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="vaultPathField" editable="true" HBox.hgrow="ALWAYS" styleClass="campo-texto"/>
                            <Button text="Browse" onAction="#handleBrowseVaultFolder" styleClass="settings-secondary-btn"/>
                            <Button text="Save" onAction="#handleSaveVaultPath" styleClass="settings-primary-btn"/>
                            <Button text="Open" onAction="#handleOpenVaultFolder" styleClass="settings-secondary-btn"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="6" styleClass="settings-active-card">
                        <Label text="OLLAMA FOLDER / EXECUTABLE" styleClass="settings-section-label"/>
                        <Label text="Where the Ollama binary is installed. You can pick the ollama executable or the folder that contains it. Leave blank to auto-detect." styleClass="settings-help" wrapText="true"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="ollamaPathField" editable="true" HBox.hgrow="ALWAYS" styleClass="campo-texto"/>
                            <Button text="Browse" onAction="#handleBrowseOllamaPath" styleClass="settings-secondary-btn"/>
                            <Button text="Save" onAction="#handleSaveOllamaPath" styleClass="settings-primary-btn"/>
                            <Button text="Open" onAction="#handleOpenOllamaFolder" styleClass="settings-secondary-btn"/>
                        </HBox>
                        <Label fx:id="ollamaPathStatus" text="" styleClass="settings-help" wrapText="true"/>
                    </VBox>

                    <Label text="LOCAL AI MODELS" styleClass="settings-section-title"/>
                    <VBox fx:id="modelsContainer" spacing="12"/>
                    <Label fx:id="statusLabel" text="" styleClass="settings-status" wrapText="true"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
